# Copy to repository .env. Do not commit the filled file.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=crypto_dw
POSTGRES_USER=crypto_local
POSTGRES_PASSWORD=replace_with_your_local_password
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_TRADES=crypto-trades
STORAGE_DESTINATION=s3
# Read the checksum-verified research copy locally; operational writes still use S3.
CANONICAL_SNAPSHOT_STORAGE=local
S3_BUCKET_NAME=your_bucket_name
S3_RUN_PREFIX=crypto/local-runs/your_team_demo
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PORT=5001
# Optional: set a valid Java 8/11/17 installation and a writable Ivy cache.
# JAVA_HOME=C:/Program Files/Java/your_java
# SPARK_IVY_DIR=C:/your_cache/ivy
