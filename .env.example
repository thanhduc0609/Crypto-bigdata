# ============================================================
# KAFKA CONFIGURATION
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=crypto-trades

# ============================================================
# OKX MARKET DATA ENDPOINTS (OPTIONAL / OVERRIDE)
# ============================================================
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_REST_URL=https://www.okx.com

# ============================================================
# AWS S3 / MINIO CONFIGURATION
# ============================================================
# Điền thông tin Access Key & Secret Key AWS của bạn
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-southeast-1

# Tên S3 Bucket đã tạo
S3_BUCKET_NAME=your-crypto-bucket-name

# Nếu dùng AWS S3 thật: để trống S3_ENDPOINT hoặc điền s3.<region>.amazonaws.com
# Nếu dùng MinIO local: S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=

# ============================================================
# STORAGE DESTINATION & PATHS
# Lựa chọn: "s3", "hdfs", "console", "all"
# ============================================================
STORAGE_DESTINATION=s3

# S3 Streaming Paths
S3_RAW_PATH=s3a://${S3_BUCKET_NAME}/crypto/streaming/trades
S3_PROCESSED_PATH=s3a://${S3_BUCKET_NAME}/crypto/streaming/candles_1m
S3_CHECKPOINT_RAW=s3a://${S3_BUCKET_NAME}/checkpoints/trades_raw
S3_CHECKPOINT_PROCESSED=s3a://${S3_BUCKET_NAME}/checkpoints/trades_1m

# HDFS Paths (nếu chạy song song hoặc lưu local)
HDFS_RAW_PATH=hdfs://localhost:9000/crypto/raw/trades
HDFS_PROCESSED_PATH=hdfs://localhost:9000/crypto/processed/trades_1m
HDFS_CHECKPOINT_RAW=hdfs://localhost:9000/crypto/checkpoints/raw_trades
HDFS_CHECKPOINT_PROCESSED=hdfs://localhost:9000/crypto/checkpoints/processed_trades_1m

# ============================================================
# STREAMING TUNING
# ============================================================
WINDOW_DURATION=1 minute
WATERMARK_DELAY=10 seconds
TRIGGER_INTERVAL=10 seconds
LARGE_TRADE_THRESHOLD_USD=100000
WHALE_ALERT_THRESHOLD_USD=500000

# ============================================================
# POSTGRESQL DATA WAREHOUSE CONFIGURATION
# ============================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=crypto_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123

